generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Global page-view counter — single shared row for all devices worldwide.
model page_views {
  id           Int      @id @default(1)
  count        BigInt   @default(0)
  /// UTC day key (YYYY-MM-DD) for soft daily growth pacing
  day          String   @default("")
  day_added    BigInt   @default(0)
  daily_target Int      @default(20000)
  updated_at   DateTime @updatedAt
}
