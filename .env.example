# Server
PORT=3000
NODE_ENV=production
SITE_URL=https://rks.ad

# PostgreSQL (required for durable OTP + counter across devices/redeploys)
DATABASE_URL=postgresql://user:password@localhost:5432/rksad?schema=public

# Resend email API (required for Partner OTP + form notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Notify@mails.rks.ad
FROM_NAME=RKS.Ad Notify

# Where partnership form submissions are delivered
PARTNER_NOTIFY_EMAIL=iam@rks.ad

# Optional logo override used inside emails
# EMAIL_LOGO_URL=https://pub-1ed86eb4d93c4a50befdc06c2eb497c1.r2.dev/rks-adlogo%2Bfinal_comp.gif

# Optional: Redis for OTP storage (Postgres is preferred)
# REDIS_URL=redis://localhost:6379

# Optional: path for file-based counter fallback
# COUNTER_FILE_PATH=./data/counter.json
