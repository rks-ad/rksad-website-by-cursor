# Server
PORT=3000
NODE_ENV=production
SITE_URL=https://rks.ad

# PostgreSQL (Prisma) — required for durable page-view counter
DATABASE_URL=postgresql://user:password@localhost:5432/rksad?schema=public

# Resend email API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Notify@mails.rks.ad

# Optional: Redis for OTP storage (falls back to in-memory Map if unset)
# REDIS_URL=redis://localhost:6379

# Optional: path for file-based counter fallback (default: ./data/counter.json)
# COUNTER_FILE_PATH=./data/counter.json
