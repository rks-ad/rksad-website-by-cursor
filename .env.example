# Server
PORT=3000
NODE_ENV=production
SITE_URL=https://rks.ad

# PostgreSQL (REQUIRED for a global counter shared across all devices)
# Without this, the counter falls back to a local file and WILL RESET on redeploy.
DATABASE_URL=postgresql://user:password@localhost:5432/rksad?schema=public

# Optional: seed the counter once when DB/file is empty (e.g. migrate from Cloudflare KV)
# COUNTER_SEED=12480

# Resend email API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Notify@mails.rks.ad

# Optional: Redis (OTP + counter fallback if Postgres is down)
# REDIS_URL=redis://localhost:6379

# Optional: path for file-based counter fallback (mount a persistent volume here)
# COUNTER_FILE_PATH=./data/counter.json
